# ── Runtime ─────────────────────
NODE_ENV=development
PORT=3001

# ── API ─────────────────
API_PREFIX=api
# Comma-separated origins allowed to call this API.
# Must include the client dev server, or the quote form will be blocked by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3111

# ── Rate limiting ─────────────────────
# Requests per window, per IP.
THROTTLE_LIMIT=120
# Window length in seconds.
THROTTLE_TTL=60

# ── Enquiries ───────────────────
# How many enquiries the in-memory store keeps before evicting the oldest.
MAX_STORED_ENQUIRIES=500
# Protects GET/PATCH/DELETE /api/v1/enquiries.
# MUST be changed before deploying — the server refuses admin access while
# this is still the default, so leads are never exposed by accident.
ADMIN_API_KEY=change-me-in-production
CONTACT_NOTIFICATION_EMAIL=info@taxi.com

# ── Docs ────────────────────
# Swagger is served automatically outside production.
# Set to true only if you deliberately want the API reference public.
ENABLE_SWAGGER=false
